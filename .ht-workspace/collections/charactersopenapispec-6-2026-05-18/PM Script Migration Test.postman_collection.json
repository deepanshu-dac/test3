		{
			"name": "4. Variable chaining",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"var data = pm.response.json();",
							"pm.environment.set(\"userId\", data[0].userId);",
							"pm.environment.set(\"postCount\", data.length);",
							"",
							"pm.test(\"Got multiple posts\", function() {",
							"    pm.expect(data.length).to.be.above(1);",
							"});",
							"",
							"pm.test(\"First post has title\", function() {",
							"    pm.expect(data[0].title).to.be.ok;",
							"    pm.expect(data[0].title).to.contain(\" \");",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
